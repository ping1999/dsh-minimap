{
  "name": "dsh-minimap",
  "description": "VS Code-style minimap (text thumbnail + draggable viewport) overlay for the dsh web GUI's side file viewer",
  "version": "0.3.2",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "agent-harness",
    "plugin",
    "minimap",
    "editor",
    "web",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ping1999/dsh-minimap.git"
  },
  "homepage": "https://github.com/ping1999/dsh-minimap",
  "bugs": {
    "url": "https://github.com/ping1999/dsh-minimap/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
